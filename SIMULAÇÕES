% IMPLEMENTAÇÃO MANUAL DA DFT;

% Vetor do sinal
x = [1 2 3 4];

% Numero de amostras
N = length(x);

% Inicializacao do vetor da DFT
X = zeros(1,N);

% Implementacao direta da DFT
for k = 0:N-1
    
    for n = 0:N-1
        
        X(k+1) = X(k+1) + x(n+1)*exp(-1j*2*pi*k*n/N);
        
    end
    
end

% FFT utilizando funcao pronta
X_fft = fft(x);

% Exibicao dos resultados
disp('Resultado da DFT Manual');

disp(X);

disp('Resultado da FFT');

disp(X_fft);


