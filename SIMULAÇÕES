%FFT DE UMA SENOIDE DISCRETA;

% Numero de amostras
N = 128;

% Frequencia normalizada da senoide
f0 = 0.1;

% Vetor de amostras
n = 0:N-1;

% Geracao da senoide discreta
x = sin(2*pi*f0*n);

% Plot do sinal no dominio do tempo
figure;

subplot(2,1,1);

stem(n,x);

title('Sinal no Dominio do Tempo');

xlabel('Amostras');

ylabel('Amplitude');

grid on;

% Calculo da FFT
X = fft(x);

% Vetor de frequencia normalizada
f = (0:N-1)/N;

% Plot do espectro
subplot(2,1,2);

plot(f,abs(X));

title('Espectro do Sinal');

xlabel('Frequencia Normalizada');

ylabel('|X(f)|');

grid on;


